{
  "name": "dsh-xiaojing-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "小鲸控制台：在 DSH 侧栏里查看和修改小鲸 App 的机器人配置",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  }
}
