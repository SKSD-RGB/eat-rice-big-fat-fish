# 复制这个文件成 .env，然后填上你自己的值
# 改完要重启网桥才生效

# ===== 必须填 =====

# DeepSeek 的 API Key（去 https://platform.deepseek.com 申请）
API_KEY=

# ===== 一般不用改 =====

# API 地址
API_BASE=https://api.deepseek.com

# 用哪个模型
#   deepseek-flash     便宜快，日常聊天推荐
#   deepseek-v4-pro    贵一些，更聪明
MODEL=deepseek-flash

# 端口（手机 App 要填一样的）
PORT=8787

# ===== 可选 =====

# 人格文件（相对本目录的路径）
# 自己写的人格放哪就填哪
PERSONA=PERSONA.example.md

# 带多少轮历史（越大越贵）
HISTORY_TURNS=16

# 智谱的 Key（配了她才能看懂你发的图）
# 去 https://open.bigmodel.cn 申请
ZHIPU_KEY=
